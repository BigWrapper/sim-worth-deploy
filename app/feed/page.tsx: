"use client"
import { useEffect, useState } from "react"
import { supabase } from "@/lib/supabase"

export default function FeedPage(){
  const [profiles, setProfiles] = useState<any[]>([])
  useEffect(()=>{
    supabase.from("profiles").select("*").order("created_at", {ascending:false}).limit(50).then(({data})=> data && setProfiles(data))
  },[])
  return (
    <div style={{background:"#000", minHeight:"100vh", maxWidth:"430px", margin:"0 auto", color:"white", padding:"12px"}}>
      <h2 style={{color:"#D4AF37"}}>Feed - Newest</h2>
      {profiles.map(p=>(
        <div key={p.handle} style={{display:"flex", gap:"12px", padding:"12px", borderBottom:"1px solid #222", alignItems:"center"}}>
          <img src={p.avatar_url || "https://i.pravatar.cc/100"} style={{width:"50px", height:"50px", borderRadius:"50%", border:"2px solid #D4AF37"}}/>
          <div><div style={{fontWeight:"700"}}>{p.handle}</div><div style={{color:"#D4AF37"}}>$ {p.net_worth}</div></div>
        </div>
      ))}
    </div>
  )
}
